    var endDate = end.getFullYear() + '-' +
        String(end.getMonth() + 1).padStart(2, '0') + '-' +
        String(end.getDate()).padStart(2, '0');

    g_form.setValue('u_start_date', startDate);
    g_form.setValue('u_end_date', endDate);
}]]></script>
