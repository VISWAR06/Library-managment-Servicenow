        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	// Add your code here
	var bookname=current.getValue('u_book_name');
	if(bookname){
		var glide=new GlideRecord('u_books');
		glide.addQuery('u_name',bookname);
		glide.query();
		if(glide.next()){
			var count=parseInt(glide.getValue('u_availabe_count'),10);
			var inc=count+1;
			glide.setValue('u_availabe_count',inc);
			glide.setWorkflow(false);
			glide.update();
		}

	}

})(current, previous);]]></script>
