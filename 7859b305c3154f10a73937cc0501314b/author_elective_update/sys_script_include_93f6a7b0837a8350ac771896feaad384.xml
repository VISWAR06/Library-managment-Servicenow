        <script><![CDATA[var fetchcategory = Class.create();
fetchcategory.prototype = Object.extendsObject(AbstractAjaxProcessor, {

    fetchcategory: function() {
        var para = this.getParameter('sysparm_record_id');
        var result = '';

        var gr = new GlideRecord('u_books');
        if (gr.get(para)) {
            result = gr.getValue('u_category');
        }

        return result;
    },

    type: 'fetchcategory'
});]]></script>
