        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	// Add your code here
	var create=new GlideRecord('u_book_issue');
	create.initialize();
	create.u_user=current.u_requested_by;
	create.u_book=current.u_book;
	var gd=new GlideDate();
	gd.setValue(gs.nowDate())
	create.u_requested_date=gd.getValue();
	var datee=new GlideDateTime();
	datee.addDaysLocalTime(20);
	create.u_due_date=datee.getDate();
	create.setValue('u_status',"issued");
	create.insert();

})(current, previous);]]></script>
