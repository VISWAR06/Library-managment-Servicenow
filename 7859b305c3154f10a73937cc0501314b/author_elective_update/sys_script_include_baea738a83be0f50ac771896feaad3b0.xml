        <description/>
        <mobile_callable>false</mobile_callable>
        <name>Status Close</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var Status_Close = Class.create();
Status_Close.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

    close: function() {

        var user = this.getParameter('sysparm_user');
        var book = this.getParameter('sysparm_book');

        var gr = new GlideRecord('u_books_request');

        gr.addQuery('u_requested_by', user);
        gr.addQuery('u_book', book);
        gr.addQuery('u_status', 'open');
        gr.query();

        if (gr.next()) {
            gr.setValue('u_status', 'closed');
            gr.update();
            return 'closed';
        }

        return 'not_found';
    },

    type: 'Status_Close'
});]]></script>
