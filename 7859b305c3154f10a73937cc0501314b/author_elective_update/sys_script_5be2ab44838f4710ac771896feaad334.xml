        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	// Add your code here
	
	var bookref=current.getValue('u_book_name');
	if(bookref){
		var glide=new GlideRecord('u_books');
		glide.addQuery('u_book_name',bookref);
		glide.query();
		if(glide.next()){
			var count=parseInt(glide.getValue('u_availabe_count'),10);
			glide.setValue('u_availabe_count',count+1);
			glide.update();
}
	}
	



})(current, previous);]]></script>
