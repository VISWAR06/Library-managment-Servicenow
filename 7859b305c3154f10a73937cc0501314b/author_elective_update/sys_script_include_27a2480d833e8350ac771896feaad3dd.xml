        <script><![CDATA[var Fetchcategory = Class.create();
Fetchcategory.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
	 fetchcategory:function(){
		var recordid=this.getParameter('sysparm_record_id');
		var result='';
		var record=new GlideRecord('u_books');
